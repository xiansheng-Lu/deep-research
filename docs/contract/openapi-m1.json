    "/api/v1/reports/{run_id}": {
      "get": {
        "tags": [
          "reports"
        ],
        "summary": "按研究运行 ID 查询报告",
        "description": "按研究运行 ID 查询报告。\n\n先校验 run 归属当前用户，再查 Report 行。",
        "operationId": "get_report_by_run_api_v1_reports__run_id__get",
        "security": [
          {
            "HTTPBearer": []
