            "title": "Status",
            "default": "draft"
          },
          "content_md": {
            "type": "string",
            "title": "Content Md"
          },
          "token_used": {
            "type": "integer",
            "title": "Token Used",
            "default": 0
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "run_id",
          "template_id",
          "content_md",
          "created_at",
          "updated_at"
        ],
        "title": "ReportResponse",
        "description": "报告视图：含 Markdown 正文。"
      },
      "RunResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "project_id": {
            "type": "string",
            "title": "Project Id"
          },
          "creator_id": {
            "type": "string",
            "title": "Creator Id"
          },
          "template_id": {
            "type": "string",
            "title": "Template Id"
          },
          "tier": {
            "type": "string",
            "enum": [
              "quick",
              "standard",
              "deep",
              "extreme"
