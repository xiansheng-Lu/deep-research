                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "default_template_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Default Template Id"
          },
          "default_tier": {
            "type": "string",
            "enum": [
              "quick",
              "standard",
              "deep",
              "extreme"
