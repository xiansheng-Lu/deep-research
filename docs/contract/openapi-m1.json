      },
      "ReportResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "template_id": {
            "type": "string",
            "title": "Template Id"
          },
