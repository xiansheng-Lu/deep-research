            "title": "Timestamp"
          }
        },
        "type": "object",
        "required": [
          "service",
          "version",
          "timestamp"
        ],
        "title": "HealthResponse",
        "description": "健康检查响应。"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
