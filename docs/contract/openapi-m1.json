          }
        ]
      }
    },
    "/api/v1/projects": {
      "get": {
        "tags": [
          "projects"
        ],
        "summary": "列出当前团队的项目",
        "description": "列出当前用户所属团队下 ``status='active'`` 且未软删除的项目。",
