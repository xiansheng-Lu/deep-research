                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateProjectRequest": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Name"
          },
          "description": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1024
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "default_tier": {
            "type": "string",
            "enum": [
              "quick",
              "standard",
              "deep",
              "extreme"
            ],
            "title": "Default Tier",
            "default": "standard"
          },
          "default_template_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ],
            "title": "Default Template Id"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "CreateProjectRequest",
        "description": "``POST /projects`` 请求体。"
      },
      "CreateRunRequest": {
        "properties": {
          "project_id": {
            "type": "string",
            "maxLength": 26,
            "minLength": 1,
            "title": "Project Id"
          },
          "question": {
            "type": "string",
            "maxLength": 4096,
            "minLength": 5,
            "title": "Question"
          },
          "tier": {
            "type": "string",
            "enum": [
              "quick",
              "standard",
              "deep",
              "extreme"
            ],
            "title": "Tier",
            "default": "standard"
          },
          "template_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ],
            "title": "Template Id"
          }
        },
        "type": "object",
        "required": [
          "project_id",
          "question"
        ],
        "title": "CreateRunRequest",
        "description": "``POST /runs`` 请求体。"
      },
      "CurrentUser": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "team_id": {
            "type": "string",
            "title": "Team Id"
          },
          "email": {
            "type": "string",
