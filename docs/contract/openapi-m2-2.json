  "components": {
    "schemas": {
      "AssistantChatRequest": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Message",
            "description": "当前用户消息"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/AssistantTurn"
            },
            "type": "array",
            "maxItems": 20,
            "title": "History"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "AssistantChatRequest",
        "description": "``POST /assistant/chat`` 请求体。"
      },
      "AssistantTurn": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Content"
          }
        },
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "AssistantTurn",
        "description": "历史对话中的一条消息。"
      },
      "ConflictDetailResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "claim": {
            "type": "string",
            "title": "Claim"
          },
          "evidence_a_id": {
            "type": "string",
            "title": "Evidence A Id"
          },
          "evidence_b_id": {
            "type": "string",
            "title": "Evidence B Id"
          },
          "type": {
            "type": "string",
            "enum": [
              "factual",
              "methodological",
              "temporal",
              "perspective"
            ],
            "title": "Type"
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "title": "Severity"
          },
          "status": {
            "type": "string",
            "enum": [
              "detected",
              "awaiting_human",
              "resolved",
              "abandoned"
            ],
            "title": "Status"
          },
          "created_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At"
          },
          "updated_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updated At"
          },
          "evidence_a": {
            "$ref": "#/components/schemas/ConflictEvidenceSummary"
          },
          "evidence_b": {
            "$ref": "#/components/schemas/ConflictEvidenceSummary"
          }
        },
        "type": "object",
        "required": [
          "id",
          "run_id",
          "claim",
          "evidence_a_id",
          "evidence_b_id",
          "type",
          "severity",
          "status",
          "evidence_a",
          "evidence_b"
        ],
        "title": "ConflictDetailResponse",
        "description": "冲突详情：冲突字段 + 双方证据摘要。"
      },
      "ConflictEvidenceSummary": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "domain": {
            "type": "string",
            "title": "Domain"
          },
          "snippet": {
            "type": "string",
            "title": "Snippet"
          },
          "credibility": {
            "type": "string",
            "title": "Credibility"
          },
          "source_type": {
            "type": "string",
            "title": "Source Type"
          },
          "published_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Published At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "url",
          "domain",
          "snippet",
          "credibility",
          "source_type"
        ],
        "title": "ConflictEvidenceSummary",
        "description": "冲突详情内嵌的一方证据摘要（FR-7 八项）。"
      },
      "ConflictResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "claim": {
            "type": "string",
            "title": "Claim"
          },
          "evidence_a_id": {
            "type": "string",
            "title": "Evidence A Id"
          },
          "evidence_b_id": {
            "type": "string",
            "title": "Evidence B Id"
          },
          "type": {
            "type": "string",
            "enum": [
              "factual",
              "methodological",
              "temporal",
              "perspective"
            ],
            "title": "Type"
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
