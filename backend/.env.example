# ===== 运行环境 =====
APP_ENV=dev
APP_NAME=deep-research-api
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
LOG_JSON=true
# Vector/Loki 采集端（stdout 旁路），留空则仅 stdout
LOG_COLLECTOR_ENDPOINT=

# ===== 安全 =====
# 生产环境请通过密钥管理服务注入，禁止写入仓库
SECRET_KEY=change-me-in-production-please-use-a-strong-random-secret
# 连接器凭证加密密钥（Fernet，M1-M2），生产必填
ENCRYPTION_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=7
COOKIE_SECURE=false

# ===== 数据库（PostgreSQL 16 + pgvector） =====
DB_ASYNC_URL=postgresql+asyncpg://deep_research:deep_research@localhost:5432/deep_research
DB_SYNC_URL=postgresql+psycopg2://deep_research:deep_research@localhost:5432/deep_research
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# 编排检查点后端：postgres=AsyncPostgresSaver（默认，HITL 支持跨请求/跨进程恢复）；
# memory=应用级单例内存 saver（仅用于无 Postgres 的测试/本地临时环境）
CHECKPOINTER_BACKEND=postgres

# ===== Redis（缓存 / 队列 / Pub-Sub） =====
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ===== 对象存储（MinIO / S3 兼容） =====
OBJECT_STORAGE_ENDPOINT=localhost:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=deep-research
OBJECT_STORAGE_SECURE=false

# ===== LLM Provider =====
# 主模型（OpenAI 兼容协议；国内联调指向 DeepSeek）
# 配置 API Key 后由 lifespan 在启动时注入真实客户端；留空则 LLM 节点走降级路径
# 现役模型名：deepseek-v4-flash（快速经济）/ deepseek-v4-pro（高质量）；
# 旧名 deepseek-chat / deepseek-reasoner 已于 2026-07-24 废弃
LLM_PRIMARY_BASE_URL=https://api.deepseek.com/v1
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_MODEL=deepseek-v4-flash
# 备用模型（用于主线路熔断后切换）
LLM_BACKUP_BASE_URL=
LLM_BACKUP_API_KEY=
LLM_BACKUP_MODEL=
# 统一超时与重试
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_CIRCUIT_FAIL_THRESHOLD=5
LLM_CIRCUIT_RESET_SECONDS=60

# ===== 检索 Provider =====
# 公域检索供应方：bocha（国内，默认）/ tavily（海外）
# 注意：若系统环境变量中存在 TAVILY_API_KEY，仍须显式设置为 bocha 才会使用博查
WEB_SEARCH_PROVIDER=bocha
# 博查（国内公域检索，https://open.bochaai.com 申请 key）
BOCHA_API_KEY=
BOCHA_BASE_URL=https://api.bochaai.com/v1
# Tavily：海外公域检索（切换 WEB_SEARCH_PROVIDER=tavily 时生效）
TAVILY_API_KEY=

# ===== 信源元数据页面补采（M2-6） =====
# Provider 未返回发布时间时是否抓页面补采（失败静默，不影响证据入库）
SOURCE_PAGE_METADATA_ENABLED=true
# 单页抓取超时秒数 / 每子问题补采页面数上限（0 等价关闭）
SOURCE_PAGE_FETCH_TIMEOUT_SECONDS=5
SOURCE_PAGE_FETCH_PER_SUBQUESTION=3

# ===== 结构化报告生成（M2-7） =====
# 终稿 blocks 结构化调用硬超时秒数与输出 token 上限；失败走机械映射降级
REPORT_LLM_TIMEOUT_SECONDS=45
REPORT_LLM_MAX_TOKENS=4096

# ===== 成本治理 =====
QUOTA_DEFAULT_TIER=standard
QUOTA_TIER_QUICK_TOKENS=50000
QUOTA_TIER_STANDARD_TOKENS=150000
QUOTA_TIER_DEEP_TOKENS=400000
QUOTA_TIER_EXTREME_TOKENS=1000000
# M2-3 实时成本：token.usage.update 最小帧间隔（毫秒）
COST_UPDATE_INTERVAL_MS=1000
# cost.warning 预警阈值（>=70% 橙，>90% 红；0.90 同时是成本挂起闸门）
COST_WARNING_RATIO=0.70
COST_DANGER_RATIO=0.90

# ===== 运维可观测 =====
# Prometheus 指标端点 GET /metrics 开关（应用根路径，无 /api/v1 前缀）
METRICS_ENABLED=true

# ===== HITL 用户介入（M2-5）=====
# 澄清挂起展示超时（秒）；仅用于 WS/REST 展示语义，后端不做超时自动续跑
CLARIFICATION_EXPIRES_SECONDS=900

# ===== 种子账号（仅 dev/staging 联调，APP_ENV=prod 时种子脚本拒绝执行） =====
SEED_TEAM_NAME=默认团队
SEED_USER_EMAIL=dev@example.com
SEED_USER_PASSWORD=Dev@123456
SEED_USER_DISPLAY_NAME=联调开发者

# ===== 实时通信 =====
WS_HEARTBEAT_SECONDS=25
SSE_HEARTBEAT_SECONDS=15

# ===== 追踪 =====
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=deep-research-api
# LLM 留痕总开关：元数据始终记录；本开关控制失败现场与采样内容落盘
LLM_TRACE_ENABLED=true
# 成功调用明文采样率 0~0.10，按 team 可热调覆盖
LLM_TRACE_SAMPLE_RATE=0.01