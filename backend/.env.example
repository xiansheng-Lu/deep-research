# ===== 运行环境 =====
APP_ENV=dev
APP_NAME=deep-research-api
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
LOG_JSON=true
# Vector/Loki 采集端（stdout 旁路），留空则仅 stdout
LOG_COLLECTOR_ENDPOINT=

# ===== 安全 =====
# 生产环境请通过密钥管理服务注入，禁止写入仓库
SECRET_KEY=change-me-in-production-please-use-a-strong-random-secret
# 连接器凭证加密密钥（Fernet，M1-M2），生产必填
ENCRYPTION_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=7
COOKIE_SECURE=false

# ===== 数据库（PostgreSQL 16 + pgvector） =====
DB_ASYNC_URL=postgresql+asyncpg://deep_research:deep_research@localhost:5432/deep_research
DB_SYNC_URL=postgresql+psycopg2://deep_research:deep_research@localhost:5432/deep_research
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ===== Redis（缓存 / 队列 / Pub-Sub） =====
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ===== 对象存储（MinIO / S3 兼容） =====
OBJECT_STORAGE_ENDPOINT=localhost:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=deep-research
OBJECT_STORAGE_SECURE=false

# ===== LLM Provider =====
# 主模型（OpenAI 兼容协议，亦可指向兼容网关）
LLM_PRIMARY_BASE_URL=https://api.openai.com/v1
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_MODEL=gpt-4o-mini
# 备用模型（用于主线路熔断后切换）
LLM_BACKUP_BASE_URL=
LLM_BACKUP_API_KEY=
LLM_BACKUP_MODEL=
# 统一超时与重试
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_CIRCUIT_FAIL_THRESHOLD=5
LLM_CIRCUIT_RESET_SECONDS=60

# ===== 检索 Provider =====
TAVILY_API_KEY=

# ===== 成本治理 =====
QUOTA_DEFAULT_TIER=standard
QUOTA_TIER_QUICK_TOKENS=50000
QUOTA_TIER_STANDARD_TOKENS=150000
QUOTA_TIER_DEEP_TOKENS=400000
QUOTA_TIER_EXTREME_TOKENS=1000000

# ===== 种子账号（仅 dev/staging 联调；APP_ENV=prod 时种子脚本拒绝执行） =====
SEED_TEAM_NAME=默认团队
SEED_USER_EMAIL=dev@example.com
SEED_USER_PASSWORD=Dev@123456
SEED_USER_DISPLAY_NAME=联调开发者

# ===== 实时通信 =====
WS_HEARTBEAT_SECONDS=25
SSE_HEARTBEAT_SECONDS=15

# ===== 追踪 =====
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=deep-research-api
# LLM 留痕总开关：元数据始终记录；本开关控制失败现场与采样内容落盘
LLM_TRACE_ENABLED=true
# 成功调用明文采样率 0~0.10，按 team 可热调覆盖
LLM_TRACE_SAMPLE_RATE=0.01