# 统一行尾策略：仓库内文本文件一律以 LF 存储
# 各平台 checkout 时按本文件规则转换，避免依赖贡献者本地 autocrlf 配置
* text=auto

# 脚本类文件强制 LF，防止 CRLF 在非 Windows 环境执行报错
*.sh text eol=lf

# Windows 批处理保留 CRLF
*.bat text eol=crlf

# 二进制文件不做行尾转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
